{
  "expo": {
    "name": "JATI",
    "slug": "JATI",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./src/components/icon/icon.png",
    "scheme": "jati",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./src/components/icon/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#25405F",
        "foregroundImage": "./src/components/icon/android-icon-foreground.png",
        "backgroundImage": "./src/components/icon/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/components/icon/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./src/components/icon/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}